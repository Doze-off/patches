From fad7836fffa85ac7ad37aed43c93cec359a4e288 Mon Sep 17 00:00:00 2001
From: "Christopher A. Williamson" <contact@chrisaw.io>
Date: Tue, 24 Mar 2026 12:44:06 +0000
Subject: [PATCH 2/3] base.mk: add VNDK v30 to PRODUCT_EXTRA_VNDK_VERSIONS

add VNDK v30 so devices shipping with VNDK 30 vendor images find
matching libraries at runtime. this complements the VNDK v30 apex
restore in platform_packages_modules_vndk.
---
 base.mk | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/base.mk b/base.mk
index 56d03d3..44f2c41 100644
--- a/base.mk
+++ b/base.mk
@@ -263,4 +263,4 @@ $(call inherit-product, $(SRC_TARGET_DIR)/product/window_extensions.mk)
 PRODUCT_PRODUCT_PROPERTIES += \
     persist.settings.large_screen_opt.enabled=true

-PRODUCT_EXTRA_VNDK_VERSIONS += 28 29
+PRODUCT_EXTRA_VNDK_VERSIONS += 28 29 30
