From 0bb1d5e5e80c014af0104fa4c3904703147443b3 Mon Sep 17 00:00:00 2001
From: dozeofffff <dozeoffff@dozeoffff>
Date: Sat, 11 Jul 2026 17:13:27 +0000
Subject: [PATCH 29/29] AudioDeviceBroker: preserve Bluetooth communication
 route on invalid phone-strategy fallback
 
Some vendor audio implementations intermittently fail to resolve a valid
communication device for STREAM_VOICE_CALL, causing
updateActiveCommunicationDevice() to clear mActiveCommunicationDevice.

When this happens, getCommunicationDeviceInt() falls back to earpiece or
another internal route even if a Bluetooth communication device was already
requested and active, which can make VoIP call audio leave the headset and
play through the phone.

Fix this by:
- preserving the previous active Bluetooth communication device when phone
  strategy resolution returns no device;
- prioritizing Bluetooth SCO / BLE headset / BLE speaker / hearing aid
  devices before built-in earpiece in communication fallback resolution.

This is a framework-side workaround for broken vendor audio policy / audio
port enumeration and improves Bluetooth call routing reliability on GSI.

---
 .../server/audio/AudioDeviceBroker.java       | 94 +++++++++++++++++++
 1 file changed, 94 insertions(+)

diff --git a/services/core/java/com/android/server/audio/AudioDeviceBroker.java b/services/core/java/com/android/server/audio/AudioDeviceBroker.java
index 31c3187f0..17578d603 100644
--- a/services/core/java/com/android/server/audio/AudioDeviceBroker.java
+++ b/services/core/java/com/android/server/audio/AudioDeviceBroker.java
@@ -762,6 +762,43 @@ public class AudioDeviceBroker {
     private AudioDeviceInfo  getCommunicationDeviceInt() {
         updateActiveCommunicationDevice();
         AudioDeviceInfo device = mActiveCommunicationDevice;
+
+        /*
+         * GSI workaround for broken vendor audio policy / invalid voice ports:
+         * when audio policy fails to resolve the active phone strategy device during a VoIP call,
+         * prefer an already requested Bluetooth communication route instead of falling back to
+         * earpiece / speaker.
+         */
+        if (device == null || !AudioDeviceBroker.isValidCommunicationDevice(device)) {
+            final AudioDeviceInfo btSco =
+                    getCommunicationDeviceOfType(AudioDeviceInfo.TYPE_BLUETOOTH_SCO);
+            final AudioDeviceInfo bleHeadset =
+                    getCommunicationDeviceOfType(AudioDeviceInfo.TYPE_BLE_HEADSET);
+            final AudioDeviceInfo bleSpeaker =
+                    getCommunicationDeviceOfType(AudioDeviceInfo.TYPE_BLE_SPEAKER);
+            final AudioDeviceInfo hearingAid =
+                    getCommunicationDeviceOfType(AudioDeviceInfo.TYPE_HEARING_AID);
+
+            if (isBluetoothScoRequested() && btSco != null) {
+                Log.w(TAG, "getCommunicationDeviceInt(): using BT SCO fallback device " + btSco);
+                return btSco;
+            }
+            if (isBluetoothLeAudioRequested()) {
+                if (bleHeadset != null) {
+                    Log.w(TAG, "getCommunicationDeviceInt(): using BLE headset fallback "
+                            + bleHeadset);
+                    return bleHeadset;
+                }
+                if (bleSpeaker != null) {
+                    Log.w(TAG, "getCommunicationDeviceInt(): using BLE speaker fallback "
+                            + bleSpeaker);
+                    return bleSpeaker;
+                }
+            }
+            if (hearingAid != null) {
+                return hearingAid;
+            }
+        }
         // make sure we return a valid communication device (i.e. a device that is allowed by
         // setCommunicationDevice()) for consistency.
         if (device != null) {
@@ -775,6 +812,27 @@ public class AudioDeviceBroker {
         // happen for instance if no call is active. If no earpiece device is available take the
         // first valid communication device
         if (device == null || !AudioDeviceBroker.isValidCommunicationDevice(device)) {
+            final AudioDeviceInfo btSco =
+                    getCommunicationDeviceOfType(AudioDeviceInfo.TYPE_BLUETOOTH_SCO);
+            final AudioDeviceInfo bleHeadset =
+                    getCommunicationDeviceOfType(AudioDeviceInfo.TYPE_BLE_HEADSET);
+            final AudioDeviceInfo bleSpeaker =
+                    getCommunicationDeviceOfType(AudioDeviceInfo.TYPE_BLE_SPEAKER);
+            final AudioDeviceInfo hearingAid =
+                    getCommunicationDeviceOfType(AudioDeviceInfo.TYPE_HEARING_AID);
+
+            if (btSco != null) {
+                return btSco;
+            }
+            if (bleHeadset != null) {
+                return bleHeadset;
+            }
+            if (bleSpeaker != null) {
+                return bleSpeaker;
+            }
+            if (hearingAid != null) {
+                return hearingAid;
+            }
             device = getCommunicationDeviceOfType(AudioDeviceInfo.TYPE_BUILTIN_EARPIECE);
             if (device == null) {
                 List<AudioDeviceInfo> commDevices = getAvailableCommunicationDevices();
@@ -804,6 +862,42 @@ public class AudioDeviceBroker {
                     Log.w(TAG,
                             "updateActiveCommunicationDevice(): no device for phone strategy");
                 }
+
+                /*
+                 * GSI workaround:
+                 * some vendors expose broken voice ports and AudioPolicy intermittently returns
+                 * no device for the phone strategy even though Bluetooth comm routing is already
+                 * established. Preserve the previous BT active communication device in that case.
+                 */
+                if (mActiveCommunicationDevice != null) {
+                    final int type = mActiveCommunicationDevice.getType();
+                    if (type == AudioDeviceInfo.TYPE_BLUETOOTH_SCO
+                            || type == AudioDeviceInfo.TYPE_BLE_HEADSET
+                            || type == AudioDeviceInfo.TYPE_BLE_SPEAKER
+                            || type == AudioDeviceInfo.TYPE_HEARING_AID) {
+                        Log.w(TAG,
+                                "updateActiveCommunicationDevice(): preserving previous BT "
+                                + "communication device " + mActiveCommunicationDevice);
+                        return;
+                    }
+                }
+
+                if (isBluetoothScoRequested()) {
+                    mActiveCommunicationDevice =
+                            getCommunicationDeviceOfType(AudioDeviceInfo.TYPE_BLUETOOTH_SCO);
+                    return;
+                }
+                if (isBluetoothLeAudioRequested()) {
+                    mActiveCommunicationDevice =
+                            getCommunicationDeviceOfType(AudioDeviceInfo.TYPE_BLE_HEADSET);
+                    if (mActiveCommunicationDevice == null) {
+                        mActiveCommunicationDevice =
+                                getCommunicationDeviceOfType(AudioDeviceInfo.TYPE_BLE_SPEAKER);
+                    }
+                    if (mActiveCommunicationDevice != null) {
+                        return;
+                    }
+                }
                 mActiveCommunicationDevice = null;
                 return;
             }
