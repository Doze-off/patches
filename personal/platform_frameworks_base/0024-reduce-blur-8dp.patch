From: Doze-off <doze-off@doze-off>
Date: Fri, 18 Jul 2025 23:15:41 +0000
Subject: [PATCH 24/24] reduce blur 8dp

---
 packages/SystemUI/res/values/dimens.xml | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/packages/SystemUI/res/values/dimens.xml b/packages/SystemUI/res/values/dimens.xml
index 6d988cb897ab..5ddaa46a39cf 100644
--- a/packages/SystemUI/res/values/dimens.xml
+++ b/packages/SystemUI/res/values/dimens.xml
@@ -1274,13 +1274,13 @@
 
     <!--  Blur radius on status bar window and power menu  -->
     <dimen name="min_window_blur_radius">1px</dimen>
-    <dimen name="max_window_blur_radius">17.5dp</dimen>
+    <dimen name="max_window_blur_radius">8dp</dimen>
 
     <!-- Blur radius of the Notification Shade content (notifications, footer, shelf) -->
     <dimen name="max_shade_content_blur_radius">@dimen/max_window_blur_radius</dimen>
 
     <!-- Blur radius behind Notification Shade -->
-    <dimen name="max_shade_window_blur_radius">34dp</dimen>
+    <dimen name="max_shade_window_blur_radius">8dp</dimen>
 
     <!-- How much into a DisplayCutout's bounds we can go, on each side -->
     <dimen name="display_cutout_margin_consumption">0px</dimen>
