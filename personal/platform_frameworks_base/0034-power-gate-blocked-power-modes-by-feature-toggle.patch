From 940f0530d25cebb3d02630604ee6081da4752cb6 Mon Sep 17 00:00:00 2001
From: dozeofffff <dozeoffff@dozeoffff>
Date: Sun, 26 Jul 2026 15:21:18 +0000
Subject: [PATCH 34/34] power: gate blocked power modes by feature toggle

Change-Id: Ia7280ebed8c1a01a37be8763b3e8aa7be036641f
---
 .../jni/com_android_server_power_PowerManagerService.cpp    | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/services/core/jni/com_android_server_power_PowerManagerService.cpp b/services/core/jni/com_android_server_power_PowerManagerService.cpp
index 3341bfe5ec2b..3064dac6ab17 100644
--- a/services/core/jni/com_android_server_power_PowerManagerService.cpp
+++ b/services/core/jni/com_android_server_power_PowerManagerService.cpp
@@ -89,6 +89,12 @@ static void setPowerBoost(Boost boost, int32_t durationMs) {
 }
 
 static const std::unordered_set<int>& getBlockedPowerModes() {
+    static const std::unordered_set<int> kEmptyModes;
+    if (!android::base::GetBoolProperty(
+                "persist.sys.phh.power_mode_monitor_enabled", false)) {
+        return kEmptyModes;
+    }
+
     // re-read property when it changes. the property is populated
     // incrementally by power-mode-monitor.sh after boot -- new mode IDs
     // may be appended over the first ~90 seconds.
