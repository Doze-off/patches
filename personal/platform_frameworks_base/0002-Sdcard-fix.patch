From: doze <doze@doze>
Date: Mon, 23 Mar 2026 00:56:34 +0100
Subject: [PATCH 2/2] Sdcard-fix

---
 .../core/java/com/android/server/StorageManagerService.java    | 3 +--
 1 file changed, 1 insertion(+), 2 deletions(-)

diff --git a/services/core/java/com/android/server/StorageManagerService.java b/services/core/java/com/android/server/StorageManagerService.java
index 2f2a75332..f7cd6d93f 100644
--- a/services/core/java/com/android/server/StorageManagerService.java
+++ b/services/core/java/com/android/server/StorageManagerService.java
@@ -1667,8 +1667,7 @@ class StorageManagerService extends IStorageManager.Stub
 
             // Adoptable public disks are visible to apps, since they meet
             // public API requirement of being in a stable location.
-            // Assume all SDs match this as well
-            if (vol.getDisk().isAdoptable() || vol.getDisk().isSd()) {
+            if (vol.getDisk().isAdoptable()) {
                 vol.setMountFlags(vol.getMountFlags() | VolumeInfo.MOUNT_FLAG_VISIBLE_FOR_WRITE);
             } else if (vol.getDisk().isSd()) {
                 vol.setMountFlags(vol.getMountFlags() | VolumeInfo.MOUNT_FLAG_VISIBLE_FOR_WRITE);
-- 
