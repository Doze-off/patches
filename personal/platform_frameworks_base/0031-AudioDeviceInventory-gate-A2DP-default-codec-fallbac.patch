From 7bf26195274a1a2e01fff24c2c629a0695cbc540 Mon Sep 17 00:00:00 2001
From: dozeofffff <dozeoffff@dozeoffff>
Date: Sun, 19 Jul 2026 22:02:02 +0000
Subject: [PATCH 31/31] AudioDeviceInventory: gate A2DP default codec fallback
 behind  PHH property

---
 .../server/audio/AudioDeviceInventory.java    | 35 +++++++++++++++----
 1 file changed, 28 insertions(+), 7 deletions(-)

diff --git a/services/core/java/com/android/server/audio/AudioDeviceInventory.java b/services/core/java/com/android/server/audio/AudioDeviceInventory.java
index e56c8e181..ab36e725b 100644
--- a/services/core/java/com/android/server/audio/AudioDeviceInventory.java
+++ b/services/core/java/com/android/server/audio/AudioDeviceInventory.java
@@ -985,9 +985,15 @@ public class AudioDeviceInventory {
                     + " state=" + BluetoothProfile.getConnectionStateName(btInfo.mState)
                     + " isDeviceSwitch=" + btInfo.mIsDeviceSwitch);
         }
-        String address = btInfo.mDevice.getAddress();
-        if (!BluetoothAdapter.checkBluetoothAddress(address)) {
-            address = "";
+        String address;
+        final boolean enabled = SystemProperties.getBoolean(
+                "persist.sys.phh.a2dp_identity_addr", false);
+        if (enabled && btInfo.mProfile == BluetoothProfile.A2DP
+                && BluetoothAdapter.checkBluetoothAddress(btInfo.mDevice.getIdentityAddress())) {
+            address = btInfo.mDevice.getIdentityAddress();
+        } else {
+            address = btInfo.mDevice.getAddress();
+            if (!BluetoothAdapter.checkBluetoothAddress(address)) address = "";
         }
 
         AudioService.sDeviceLogger.enqueue(new EventLogger.StringEvent("BT connected:"
@@ -1114,9 +1120,15 @@ public class AudioDeviceInventory {
         }
         int volume = btInfo.mVolume;
 
-        String address = btDevice.getAddress();
-        if (!BluetoothAdapter.checkBluetoothAddress(address)) {
-            address = "";
+        String address;
+        final boolean enabled = SystemProperties.getBoolean(
+                "persist.sys.phh.a2dp_identity_addr", false);
+        if (enabled && btInfo.mProfile == BluetoothProfile.A2DP
+                && BluetoothAdapter.checkBluetoothAddress(btDevice.getIdentityAddress())) {
+            address = btDevice.getIdentityAddress();
+        } else {
+            address = btDevice.getAddress();
+            if (!BluetoothAdapter.checkBluetoothAddress(address)) address = "";
         }
         AudioService.sDeviceLogger.enqueue(new EventLogger.StringEvent(
                 "onBluetoothDeviceConfigChange addr=" + address
@@ -2320,9 +2332,18 @@ public class AudioDeviceInventory {
     private void makeA2dpDeviceAvailable(AudioDeviceBroker.BtDeviceInfo btInfo,
                                          @AudioSystem.AudioFormatNativeEnumForBtCodec int codec,
                                          String eventSource) {
-        final String address = btInfo.mDevice.getAddress();
         final String name = BtHelper.getName(btInfo.mDevice);
 
+        String address;
+        final boolean enabled = SystemProperties.getBoolean(
+                "persist.sys.phh.a2dp_identity_addr", false);
+        if (enabled
+                && BluetoothAdapter.checkBluetoothAddress(btInfo.mDevice.getIdentityAddress())) {
+            address = btInfo.mDevice.getIdentityAddress();
+        } else {
+            address = btInfo.mDevice.getAddress();
+            if (!BluetoothAdapter.checkBluetoothAddress(address)) address = "";
+        }
         // enable A2DP before notifying A2DP connection to avoid unnecessary processing in
         // audio policy manager
         mDeviceBroker.setBluetoothA2dpOnInt(true, true /*fromA2dp*/, eventSource);
-- 
