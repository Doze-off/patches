diff --git a/system.prop b/system.prop
index 41a0688..242b814 100644
--- a/system.prop
+++ b/system.prop
@@ -49,18 +49,29 @@ bluetooth.profile.sap.server.enabled?=true
 # Samsung vendors default to a Samsung-specific gadget for MTP. Set this to use AOSP's functionfs MTP
 vendor.usb.use_ffs_mtp=1
 
-# lmkd tuning: safe defaults for GSI across diverse hardware
-# Disable critical_upgrade to prevent overly aggressive kills on devices
-# where memory pressure detection may not work correctly (e.g., older kernels)
-ro.lmk.critical_upgrade=false
-# Kill heaviest task first for more predictable memory management
-ro.lmk.kill_heaviest_task=true
-
-# Heap floor: vendor build.prop values as low as 16m are seen in the wild.
-# Android 16 system_server needs ~200m+ to initialise; override with a safe
-# minimum while preserving larger vendor values via the ? default operator.
-dalvik.vm.heapgrowthlimit?=256m
-dalvik.vm.heapsize?=512m
+# Force LTE_CA
+persist.sys.radio.force_lte_ca=true
+
+#fix boot on phones 3-4gb <--
+dalvik.vm.heapgrowthlimit=256m
+dalvik.vm.heapmaxfree=16m
+dalvik.vm.heapminfree=8m
+dalvik.vm.heapsize=512m
+dalvik.vm.heapstartsize=8m
+dalvik.vm.heaptargetutilization=0.6
+
+persist.sys.perf.scroll_opt=true
+persist.sys.perf.scroll_opt.heavy_app=2
+ro.surface_flinger.uclamp.min=180
+
+# RIL Powersaving
+persist.radio.add_power_save=1
+pm.sleep_mode=1
+ro.ril.disable.power.collapse=0
+ro.ril.fast.dormancy.rule=1
+ro.ril.fast.dormancy.timeout=3
+ro.mot.eri.losalert.delay=1000
+
 
 # disable QPR2 vsync omission optimisation for GSI compatibility.
 # on GSI builds, vendor HWCs may not properly initialise DRM vblank
@@ -69,3 +80,7 @@ dalvik.vm.heapsize?=512m
 # state and composition stalls.  disabling it restores QPR0 behaviour
 # where synthetic vsync keeps composition alive as a fallback.
 debug.sf.no_vsyncs_on_screen_off=false
+
+
+# Everything that exists is born without reason, prolongs itself through weakness and dies through an unforeseen encounter.
+
