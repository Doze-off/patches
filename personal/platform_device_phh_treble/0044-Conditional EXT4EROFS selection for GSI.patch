From 3aa2446a3612817664b86fa957c90cd81aa5c403 Mon Sep 17 00:00:00 2001
From: dozeofffff <dozeoffff@dozeoffff>
Date: Sat, 11 Jul 2026 21:46:40 +0000
Subject: [PATCH 44/44] Conditional EXT4/EROFS selection for GSI

# Select GSI filesystem type via TARGET_FS_TYPE:
#   TARGET_FS_TYPE=ext4  -> ext4 GSI
#   TARGET_FS_TYPE=erofs -> erofs GSI (lz4hc,9 compressor)
# Removes hardcoded ext4 and allows building both fs types from same config.

---
 tdgsi_arm64_ab/BoardConfig.mk | 24 ++++++++++++++++--------
 1 file changed, 16 insertions(+), 8 deletions(-)

diff --git a/tdgsi_arm64_ab/BoardConfig.mk b/tdgsi_arm64_ab/BoardConfig.mk
index db6076f..7c5d29c 100644
--- a/tdgsi_arm64_ab/BoardConfig.mk
+++ b/tdgsi_arm64_ab/BoardConfig.mk
@@ -15,12 +15,20 @@ SELINUX_IGNORE_NEVERALLOWS := true
 
 ALLOW_MISSING_DEPENDENCIES=true
 
-TARGET_ENABLE_MEDIADRM_64 :=
-
-BOARD_RAMDISK_USE_LZ4 := true
-
-BOARD_CACHEIMAGE_FILE_SYSTEM_TYPE := ext4
-BOARD_CACHEIMAGE_PARTITION_SIZE := 16777216
+# ------------------------------------------------------------------------------
+# Build EXT4
+# ------------------------------------------------------------------------------
+ifeq ($(TARGET_FS_TYPE),ext4)
+    GSI_FILE_SYSTEM_TYPE := ext4
+    BOARD_EXT4_SHARE_DUP_BLOCKS := true
+endif
 
-GSI_FILE_SYSTEM_TYPE := ext4
-BOARD_EXT4_SHARE_DUP_BLOCKS := true
+# ------------------------------------------------------------------------------
+# Build EROFS
+# ------------------------------------------------------------------------------
+ifeq ($(TARGET_FS_TYPE),erofs)
+    GSI_FILE_SYSTEM_TYPE := erofs
+    BOARD_EROFS_COMPRESSOR := lz4hc,9
+    BOARD_PRODUCTIMAGE_FILE_SYSTEM_TYPE := erofs
+    BOARD_SYSTEM_EXTIMAGE_FILE_SYSTEM_TYPE := erofs
+endif
-- 
