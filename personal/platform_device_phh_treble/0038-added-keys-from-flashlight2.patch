From: dozeofffff <dozeoffff@dozeoffff>
Date: Thu, 25 Jun 2026 01:56:54 +0000
Subject: [PATCH 38/38] added keys from flashlight2

---
 files/cubot-mtk.kl.raw | 8 +++++++-
 rw-system.sh           | 5 +++--
 2 files changed, 10 insertions(+), 3 deletions(-)

diff --git a/files/cubot-mtk.kl.raw b/files/cubot-mtk.kl.raw
index ef4196f..02ba1c4 100644
--- a/files/cubot-mtk.kl.raw
+++ b/files/cubot-mtk.kl.raw
@@ -1 +1,7 @@
-key 250   FLASHLIGHT
+key 114   VOLUME_DOWN   WAKE_DROPPED
+key 115   VOLUME_UP     WAKE_DROPPED
+key 116   POWER         WAKE
+key 212   FLASHLIGHT    WAKE
+key 216   CAMERA        WAKE
+key 217   SEARCH        WAKE_DROPPED
+key 250   FLASHLIGHT    WAKE
diff --git a/rw-system.sh b/rw-system.sh
index cd9ac70..c1c73aa 100644
--- a/rw-system.sh
+++ b/rw-system.sh
@@ -310,12 +310,13 @@ changeKeylayout() {
         changed=true
     fi
 
-    if getprop ro.product.device  | grep -q -i -e  KINGKONG_POWER_5;then
+    if getprop ro.product.device | grep -qi 'KINGKONG_POWER_5'; then
+        mkdir -p /mnt/phh/keylayout
         cp /system/phh/cubot-mtk.kl /mnt/phh/keylayout/mtk-kpd.kl
         chmod 0644 /mnt/phh/keylayout/mtk-kpd.kl
+        chcon u:object_r:system_file:s0 /mnt/phh/keylayout/mtk-kpd.kl
         changed=true
     fi
-
     if getprop ro.product.vendor.device |grep -qi -e mfh505glm -e fh50lm; then
         cp /mnt/phh/empty /mnt/phh/keylayout/uinput-fpc.kl
         chmod 0644 /mnt/phh/keylayout/uinput-fpc.kl
