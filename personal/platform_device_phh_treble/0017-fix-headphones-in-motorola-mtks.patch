From 2132bee6be1768ab93cd479c9dff5464b940b12a Mon Sep 17 00:00:00 2001
From: Doze-off <viniciussadxxx@gmail.com>
Date: Thu, 11 Jun 2026 00:22:30 -0300
Subject: [PATCH 17/17] fix headphones in motorola mtks

---
 sepolicy/mediatek.te | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/sepolicy/mediatek.te b/sepolicy/mediatek.te
index 6c74e75..67c2879 100644
--- a/sepolicy/mediatek.te
+++ b/sepolicy/mediatek.te
@@ -33,3 +33,10 @@ permissive tkcore;
 
 allow platform_app sysfs_leds:dir r_dir_perms;
 allow platform_app sysfs_leds:file r_file_perms;
+
+
+# Needed for headphone detection when opening /bus/platform/drivers/pmic-codec-accdet/state
+allow mtk_hal_audio sysfs:file r_file_perms;
+
+# Missing permission to write to /data/vendor_de/fpdata/user.db; Biometrics releated.
+allow hal_fingerprint_default self:capability { dac_read_search dac_override };
