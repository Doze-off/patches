 evox.mk     | 15 ++++-----------
 evox_gsi.mk |  7 +++----
 2 files changed, 7 insertions(+), 15 deletions(-)

diff --git a/evox.mk b/evox.mk
index 7c058ee..7850549 100755
--- a/evox.mk
+++ b/evox.mk
@@ -9,24 +9,17 @@ TARGET_NO_KERNEL_OVERRIDE := true
 TARGET_NO_KERNEL_IMAGE := true
 
 PRODUCT_OTA_ENFORCE_VINTF_KERNEL_REQUIREMENTS := false
