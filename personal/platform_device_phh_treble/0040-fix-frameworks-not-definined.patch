From: dozeofffff <dozeoffff@dozeoffff>
Date: Sun, 5 Jul 2026 19:35:51 +0000
Subject: [PATCH 40/40] fix frameworks not definined

---
 base.mk                            |  5 ++++-
 framework_manifest_mtk_radioex.xml | 16 ++++++++++++++++
 2 files changed, 20 insertions(+), 1 deletion(-)
 create mode 100644 framework_manifest_mtk_radioex.xml

diff --git a/base.mk b/base.mk
index 827e5bc..872014a 100644
--- a/base.mk
+++ b/base.mk
@@ -106,7 +106,9 @@ PRODUCT_PACKAGES += \
     vendor.xiaomi.hardware.displayfeature-V1.0-java
 
 PRODUCT_COPY_FILES += \
-    device/phh/treble/interfaces.xml:system/etc/permissions/interfaces.xml
+    device/phh/treble/interfaces.xml:system/etc/permissions/interfaces.xml \
+    device/phh/treble/framework_manifest_mtk_radioex.xml:system/etc/vintf/manifest/framework_manifest_mtk_radioex.xml \
+    device/phh/treble/framework_manifest.xml:system/etc/vintf/manifest/framework_manifest.xml
 
 PRODUCT_COPY_FILES += \
     device/phh/treble/files/samsung-gpio_keys.kl.raw:system/phh/samsung-gpio_keys.kl \
@@ -244,6 +246,7 @@ include build/make/target/product/gsi_release.mk
 PRODUCT_COPY_FILES += \
     device/phh/treble/files/com.android.deskclock_whitelist.xml:system/etc/sysconfig/com.android.deskclock_whitelist.xml
 
+
 PRODUCT_PACKAGES += \
     evgrab \
 
diff --git a/framework_manifest_mtk_radioex.xml b/framework_manifest_mtk_radioex.xml
new file mode 100644
index 0000000..c6830ae
--- /dev/null
+++ b/framework_manifest_mtk_radioex.xml
@@ -0,0 +1,16 @@
+<?xml version="1.0" encoding="utf-8"?>
+<manifest version="1.0" type="framework">
+    <hal format="aidl">
+        <name>vendor.mediatek.hardware.mtkradioex</name>
+        <transport>hwbinder</transport>
+        <version>3.0</version>
+        <interface>
+            <name>IMtkRadioEx</name>
+            <instance>imsSlot1</instance>
+        </interface>
+        <interface>
+            <name>IMtkRadioEx</name>
+            <instance>imsSlot2</instance>
+        </interface>
+    </hal>
+</manifest>
