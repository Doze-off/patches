From fca2166489227c1e9f78cc4cc0c8c799fd9bb3e9 Mon Sep 17 00:00:00 2001
From: dozeofffff <dozeoffff@dozeoffff>
Date: Sat, 11 Jul 2026 23:04:38 +0000
Subject: [PATCH 45/45] Conditional EXT4/EROFS selection for GSI

---
 base.mk                       | 21 +++++++++++++++++++++
 tdgsi_arm64_ab/BoardConfig.mk | 18 ------------------
 2 files changed, 21 insertions(+), 18 deletions(-)

diff --git a/base.mk b/base.mk
index f372b07..44c1eec 100644
--- a/base.mk
+++ b/base.mk
@@ -291,3 +291,24 @@ TARGET_2ND_CPU_ABI :=
 TARGET_2ND_CPU_ABI2 :=
 
 -include vendor/dozeoff-priv/keys/keys.mk
+
+# ------------------------------------------------------------------------------
+# Build EXT4
+# ------------------------------------------------------------------------------
+ifeq ($(TARGET_FS_TYPE),ext4)
+    GSI_FILE_SYSTEM_TYPE := ext4
+    BOARD_EXT4_SHARE_DUP_BLOCKS := true
+    BOARD_PRODUCTIMAGE_FILE_SYSTEM_TYPE := ext4
+    BOARD_SYSTEM_EXTIMAGE_FILE_SYSTEM_TYPE := ext4
+endif
+
+# ------------------------------------------------------------------------------
+# Build EROFS
+# ------------------------------------------------------------------------------
+ifeq ($(TARGET_FS_TYPE),erofs)
+    GSI_FILE_SYSTEM_TYPE := erofs
+    BOARD_EROFS_COMPRESSOR := lz4hc,9
+    BOARD_PRODUCTIMAGE_FILE_SYSTEM_TYPE := erofs
+    BOARD_SYSTEM_EXTIMAGE_FILE_SYSTEM_TYPE := erofs
+endif
+
diff --git a/tdgsi_arm64_ab/BoardConfig.mk b/tdgsi_arm64_ab/BoardConfig.mk
index 7c5d29c..aeb625f 100644
--- a/tdgsi_arm64_ab/BoardConfig.mk
+++ b/tdgsi_arm64_ab/BoardConfig.mk
@@ -14,21 +14,3 @@ BUILD_BROKEN_MISSING_REQUIRED_MODULES := true
 SELINUX_IGNORE_NEVERALLOWS := true
 
 ALLOW_MISSING_DEPENDENCIES=true
-
-# ------------------------------------------------------------------------------
-# Build EXT4
-# ------------------------------------------------------------------------------
-ifeq ($(TARGET_FS_TYPE),ext4)
-    GSI_FILE_SYSTEM_TYPE := ext4
-    BOARD_EXT4_SHARE_DUP_BLOCKS := true
-endif
-
-# ------------------------------------------------------------------------------
-# Build EROFS
-# ------------------------------------------------------------------------------
-ifeq ($(TARGET_FS_TYPE),erofs)
-    GSI_FILE_SYSTEM_TYPE := erofs
-    BOARD_EROFS_COMPRESSOR := lz4hc,9
-    BOARD_PRODUCTIMAGE_FILE_SYSTEM_TYPE := erofs
-    BOARD_SYSTEM_EXTIMAGE_FILE_SYSTEM_TYPE := erofs
-endif
