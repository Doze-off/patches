From 59f8baf1ecfa2e5dd787e20212926ff730bb707f Mon Sep 17 00:00:00 2001
From: dozeofffff <dozeoffff@dozeoffff>
Date: Sun, 5 Jul 2026 21:50:05 +0000
Subject: [PATCH 41/41] fix erros in manifest

---
 base.mk                            | 4 +---
 board-base.mk                      | 4 +++-
 framework_manifest_mtk_radioex.xml | 5 +----
 3 files changed, 5 insertions(+), 8 deletions(-)

diff --git a/base.mk b/base.mk
index 872014a..8cbd152 100644
--- a/base.mk
+++ b/base.mk
@@ -106,9 +106,7 @@ PRODUCT_PACKAGES += \
     vendor.xiaomi.hardware.displayfeature-V1.0-java
 
 PRODUCT_COPY_FILES += \
-    device/phh/treble/interfaces.xml:system/etc/permissions/interfaces.xml \
-    device/phh/treble/framework_manifest_mtk_radioex.xml:system/etc/vintf/manifest/framework_manifest_mtk_radioex.xml \
-    device/phh/treble/framework_manifest.xml:system/etc/vintf/manifest/framework_manifest.xml
+    device/phh/treble/interfaces.xml:system/etc/permissions/interfaces.xml
 
 PRODUCT_COPY_FILES += \
     device/phh/treble/files/samsung-gpio_keys.kl.raw:system/phh/samsung-gpio_keys.kl \
diff --git a/board-base.mk b/board-base.mk
index c38e385..1e751e9 100644
--- a/board-base.mk
+++ b/board-base.mk
@@ -4,7 +4,9 @@ TARGET_SYSTEM_PROP := device/phh/treble/system.prop $(TARGET_SYSTEM_PROP)
 BOARD_BLUETOOTH_BDROID_BUILDCFG_INCLUDE_DIR := device/phh/treble/bluetooth/include
 
 TARGET_EXFAT_DRIVER := exfat
-DEVICE_FRAMEWORK_MANIFEST_FILE := device/phh/treble/framework_manifest.xml
+DEVICE_FRAMEWORK_MANIFEST_FILE := \
+    device/phh/treble/framework_manifest.xml \
+    device/phh/treble/framework_manifest_mtk_radioex.xml
 
 BOARD_ROOT_EXTRA_FOLDERS += bt_firmware sec_storage efs persist
 BUILD_BROKEN_ELF_PREBUILT_PRODUCT_COPY_FILES := true
diff --git a/framework_manifest_mtk_radioex.xml b/framework_manifest_mtk_radioex.xml
index c6830ae..4e664eb 100644
--- a/framework_manifest_mtk_radioex.xml
+++ b/framework_manifest_mtk_radioex.xml
@@ -3,13 +3,10 @@
     <hal format="aidl">
         <name>vendor.mediatek.hardware.mtkradioex</name>
         <transport>hwbinder</transport>
-        <version>3.0</version>
+        <version>3</version>
         <interface>
             <name>IMtkRadioEx</name>
             <instance>imsSlot1</instance>
-        </interface>
-        <interface>
-            <name>IMtkRadioEx</name>
             <instance>imsSlot2</instance>
         </interface>
     </hal>
