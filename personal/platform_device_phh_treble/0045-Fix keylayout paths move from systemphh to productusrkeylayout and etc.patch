+    device/phh/treble/files/daisy-uinput-fpc.kl.raw:/system/product/usr/keylayout/daisy-uinput-fpc.kl \
+    device/phh/treble/files/daisy-uinput-goodix.kl.raw:/system/product/usr/keylayout/daisy-uinput-goodix.kl \
+    device/phh/treble/files/nubia-nubia_synaptics_dsx.kl.raw:/system/product/usr/keylayout/nubia-nubia_synaptics_dsx.kl \
+    device/phh/treble/files/nubia-nubia_goodix_ts.kl.raw:/system/product/usr/keylayout/nubia-nubia_goodix_ts.kl \
