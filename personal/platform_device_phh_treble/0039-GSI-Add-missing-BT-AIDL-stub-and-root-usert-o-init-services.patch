From 034ba8060b2ee9b37b796ddc9099aa2c4be84eb7 Mon Sep 17 00:00:00 2001
From: Doze-off <viniciussadxxx@gmail.com>
Date: Fri, 26 Jun 2026 20:56:29 +0000
Subject: [PATCH 39/39] GSI: Fix BluetoothAudioProvider AIDL compliance and init service permissions

Add a stub implementation for the new AIDL method
getLeAudioAseCodecConfiguredParameters in BluetoothAudioProvider
to fix build breakage caused by unimplemented interface method.

Also add missing `user root` directive to several init rc service
definitions (adbd, phh-remotectl, phh_on_boot, power_mode_monitor,
watchdogd-gsi) to ensure they run with the correct permissions.



---
 bluetooth/audio/hal/BluetoothAudioProvider.h | 12 ++++++++++++
 files/adbd.rc                                |  1 +
 remote/phh-remotectl.rc                      |  1 +
 vndk.rc                                      |  3 +++
 4 files changed, 17 insertions(+)

diff --git a/bluetooth/audio/hal/BluetoothAudioProvider.h b/bluetooth/audio/hal/BluetoothAudioProvider.h
index 866eaeb..0c57d3d 100644
--- a/bluetooth/audio/hal/BluetoothAudioProvider.h
+++ b/bluetooth/audio/hal/BluetoothAudioProvider.h
@@ -110,6 +110,18 @@ class BluetoothAudioProvider : public BnBluetoothAudioProvider {
       const std::optional<std::vector<std::optional<
           ::aidl::android::hardware::bluetooth::audio::MetadataLtv>>>&
           in_metadata) override;
+  ndk::ScopedAStatus getLeAudioAseCodecConfiguredParameters(
+      const std::optional<std::vector<std::optional<
+          ::aidl::android::hardware::bluetooth::audio::LeAudioAseConfiguration>>>&
+          in_sinkAseConfiguration,
+      const std::optional<std::vector<std::optional<
+          ::aidl::android::hardware::bluetooth::audio::LeAudioAseConfiguration>>>&
+          in_sourceAseConfiguration,
+      std::optional<::aidl::android::hardware::bluetooth::audio::
+                        IBluetoothAudioProvider::LeAudioAseCodecConfiguredResponse>*
+          _aidl_return) override {
+    return ndk::ScopedAStatus::ok();
+  }
   ndk::ScopedAStatus getLeAudioBroadcastConfiguration(
       const std::optional<std::vector<std::optional<
           ::aidl::android::hardware::bluetooth::audio::IBluetoothAudioProvider::
diff --git a/files/adbd.rc b/files/adbd.rc
index 55b3311..06a8bbb 100644
--- a/files/adbd.rc
+++ b/files/adbd.rc
@@ -1,5 +1,6 @@
 service adbd_system /system/bin/adbd --root_seclabel=u:r:su:s0
 	class core
+	user root
 	socket adbd stream 660 system system
 	disabled
 	seclabel u:r:adbd:s0
diff --git a/remote/phh-remotectl.rc b/remote/phh-remotectl.rc
index 3e7aec1..0cb7c96 100644
--- a/remote/phh-remotectl.rc
+++ b/remote/phh-remotectl.rc
@@ -10,4 +10,5 @@ on property:persist.sys.phh.remote=false
 
 
 service phh-remotectl /system/bin/phh-remotectl.sh
+   user root
    seclabel u:r:phhsu_daemon:s0
diff --git a/vndk.rc b/vndk.rc
index 352fac6..fcef263 100644
--- a/vndk.rc
+++ b/vndk.rc
@@ -13,10 +13,12 @@ on early-boot
     exec - root -- /system/bin/phh-on-data.sh
 
 service phh_on_boot /system/bin/phh-on-boot.sh
+    user root
     oneshot
     disabled
 
 service power_mode_monitor /system/bin/power-mode-monitor.sh
+    user root
     oneshot
     disabled
     seclabel u:r:phhsu_daemon:s0
@@ -202,6 +204,7 @@ on property:persist.sys.phh.restricted_networking=*
 
 # Set watchdog timer to 30 seconds and pet it every 10 seconds to get a 20 second margin
 service watchdogd-gsi /system/bin/watchdogd 10 20
+    user root
     class core
     oneshot
     disabled
-- 
