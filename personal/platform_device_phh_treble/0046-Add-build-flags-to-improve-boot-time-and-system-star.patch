From 1445a20fba1bd02f072b327a1f08057f3d02ec0a Mon Sep 17 00:00:00 2001
From: dozeofffff <dozeoffff@dozeoffff>
Date: Sat, 18 Jul 2026 22:04:50 +0000
Subject: [PATCH 46/46] Add build flags to improve boot time and system startup
 performance.

---
 tdgsi_arm64_ab/BoardConfig.mk | 14 ++++++--------
 1 file changed, 6 insertions(+), 8 deletions(-)

diff --git a/tdgsi_arm64_ab/BoardConfig.mk b/tdgsi_arm64_ab/BoardConfig.mk
index db6076f..68c9dfa 100644
--- a/tdgsi_arm64_ab/BoardConfig.mk
+++ b/tdgsi_arm64_ab/BoardConfig.mk
@@ -15,12 +15,10 @@ SELINUX_IGNORE_NEVERALLOWS := true
 
 ALLOW_MISSING_DEPENDENCIES=true
 
-TARGET_ENABLE_MEDIADRM_64 :=
 
-BOARD_RAMDISK_USE_LZ4 := true
-
-BOARD_CACHEIMAGE_FILE_SYSTEM_TYPE := ext4
-BOARD_CACHEIMAGE_PARTITION_SIZE := 16777216
-
-GSI_FILE_SYSTEM_TYPE := ext4
-BOARD_EXT4_SHARE_DUP_BLOCKS := true
+WITH_DEXPREOPT := true #precompile system code for faster first boot and app startup.
+WITH_DEXPREOPT_PIC := true # make that preopt output more layout-friendly
+TARGET_FLATTEN_APEX := true #use flattened APEX layout, easier boot path.
+MINIMAL_FONT_FOOTPRINT := true #shrink fonts footprint.
+BOARD_RAMDISK_USE_LZ4 := true # faster ramdisk decompression
+BOARD_USES_SYSTEM_OTHER_ODEX := true #control where odex artifacts land
-- 
