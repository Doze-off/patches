From: doze-off <viniciussadxxx@gmail.com>
Date: Fri, 20 Nov 2026 05:18:19 +0000
Subject: [PATCH 5/8] config missing files

---
 base.mk            |  4 +++
 board-base.mk      |  1 +
 charger/Android.mk | 68 ----------------------------------------------
 flags.mk           |  9 +++---
 4 files changed, 9 insertions(+), 73 deletions(-)

diff --git a/base.mk b/base.mk
index 1a4c837..faf7cbf 100644
--- a/base.mk
+++ b/base.mk
@@ -279,4 +279,8 @@ PRODUCT_PRODUCT_PROPERTIES += \
 
 PRODUCT_EXTRA_VNDK_VERSIONS += 28 29 30
 
+PRODUCT_PACKAGES += \
+    com.google.android.gsf \
+    com.google.android.gsf.login
+
 $(call inherit-product, device/phh/treble/flags.mk)
diff --git a/board-base.mk b/board-base.mk
index cab702f..0de2799 100644
--- a/board-base.mk
+++ b/board-base.mk
@@ -6,5 +6,6 @@ DEVICE_FRAMEWORK_MANIFEST_FILE := device/phh/treble/framework_manifest.xml
 
 BOARD_ROOT_EXTRA_FOLDERS += bt_firmware sec_storage efs persist
 BUILD_BROKEN_ELF_PREBUILT_PRODUCT_COPY_FILES := true
+BUILD_BROKEN_MISSING_REQUIRED_MODULES := true
 
 BOARD_ROOT_EXTRA_SYMLINKS := $(filter-out $(BOARD_ROOT_EXTRA_SYMLINKS),/mnt/vendor/persist:/persist)
diff --git a/charger/Android.mk b/charger/Android.mk
index cc18272..e69de29 100644
--- a/charger/Android.mk
+++ b/charger/Android.mk
@@ -1,68 +0,0 @@
