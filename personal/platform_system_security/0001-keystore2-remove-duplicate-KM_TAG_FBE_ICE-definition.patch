From d3d6dfbb71e914e779c6f0b643b4bfdcbab24e54 Mon Sep 17 00:00:00 2001
From: doze-off <viniciussadxxx@gmail.com>
Date: Sat, 7 Nov 2026 13:27:01 +0000
Subject: [PATCH] keystore2: remove duplicate KM_TAG_FBE_ICE definition

The FBE_ICE vendor tag is already available through the KeyMint
Tag type. Remove the local constexpr definition and compare the
tag directly, avoiding redundant static_cast conversions.

Change-Id: I0f6ca8e211544f87438dde9db3cdb3a6c542ac9f
---
 keystore2/src/km_compat/km_compat.cpp | 7 ++-----
 1 file changed, 2 insertions(+), 5 deletions(-)

diff --git a/keystore2/src/km_compat/km_compat.cpp b/keystore2/src/km_compat/km_compat.cpp
index eb653dce..ed45fb29 100644
--- a/keystore2/src/km_compat/km_compat.cpp
+++ b/keystore2/src/km_compat/km_compat.cpp
@@ -87,9 +87,6 @@ bool isAttestationParameter(const KMV1::KeyParameter& param) {
     }
 }
 
-// qti keymaster only allows the raw export of storage keys generated with this vendor tag.
-constexpr int32_t KM_TAG_FBE_ICE = static_cast<int32_t>(7u << 28) | 16201;
-
 // Returns true if this parameter may be passed to generate/importKey.
 bool isKeyCreationParameter(const KMV1::KeyParameter& param) {
     switch (param.tag) {
@@ -135,7 +132,7 @@ bool isKeyCreationParameter(const KMV1::KeyParameter& param) {
     case Tag::MAC_LENGTH:
         return true;
     default:
-        return static_cast<int32_t>(param.tag) == KM_TAG_FBE_ICE;
+        return param.tag == KM_TAG_FBE_ICE;
     }
 }
 
@@ -303,7 +300,7 @@ convertKeyParametersToLegacy(const std::vector<KeyParameter>& kps) {
     std::vector<V4_0::KeyParameter> legacyKps;
     legacyKps.reserve(kps.size());
     for (const auto& kp : kps) {
-        if (static_cast<int32_t>(kp.tag) == KM_TAG_FBE_ICE) {
+        if (kp.tag == KM_TAG_FBE_ICE) {
             V4_0::KeyParameter p;
             p.tag = static_cast<V4_0::Tag>(KM_TAG_FBE_ICE);
             p.f.boolValue = true;
-- 
2.43.0

