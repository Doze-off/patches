From e30ed6613e30e6e51c91341ac24bb10450559485 Mon Sep 17 00:00:00 2001
From: doze-off <doze@doze>
Date: Sun, 11 Jan 2026 17:40:20 +0000
Subject: [PATCH] FIX bionic in magisk vendor

---
 Magisk/native/jni/systemproperties/prop_area.cpp | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/Magisk/native/jni/systemproperties/prop_area.cpp b/Magisk/native/jni/systemproperties/prop_area.cpp
index b834935..82cf317 100644
--- a/Magisk/native/jni/systemproperties/prop_area.cpp
+++ b/Magisk/native/jni/systemproperties/prop_area.cpp
@@ -147,7 +147,9 @@ prop_area* prop_area::map_prop_area(const char* filename) {
 }
 
 void* prop_area::allocate_obj(const size_t size, uint_least32_t* const off) {
-  const size_t aligned = __BIONIC_ALIGN(size, sizeof(uint_least32_t));
+  constexpr size_t kAlign = alignof(uint_least32_t);
+  const size_t aligned = (size + kAlign - 1) & ~(kAlign - 1);
+
   if (bytes_used_ + aligned > pa_data_size_) {
     return nullptr;
   }
