From 3c3962943976f28c815b3d2c6ed3c85a3564966c Mon Sep 17 00:00:00 2001
From: doze-off <viniciussadxxx@gmail.com>
Date: Sat, 28 Nov 2026 07:23:50 +0000
Subject: [PATCH] Add HIDL vibrator 1.0 interface for legacy vendor HAL 
 compatibility

---
 .../exclude/fcm_exclude.cpp                   |  1 +
 vibrator/1.0/Android.bp                       | 15 ++++
 vibrator/1.0/IVibrator.hal                    | 72 +++++++++++++++++++
 vibrator/1.0/types.hal                        | 48 +++++++++++++
 4 files changed, 136 insertions(+)
 create mode 100644 vibrator/1.0/Android.bp
 create mode 100644 vibrator/1.0/IVibrator.hal
 create mode 100644 vibrator/1.0/types.hal

diff --git a/compatibility_matrices/exclude/fcm_exclude.cpp b/compatibility_matrices/exclude/fcm_exclude.cpp
index b24bae5..bc795bc 100644
--- a/compatibility_matrices/exclude/fcm_exclude.cpp
+++ b/compatibility_matrices/exclude/fcm_exclude.cpp
@@ -95,6 +95,7 @@ bool ShouldCheckMissingHidlHalsInFcm(const std::string& packageAndVersion) {
             "android.hardware.dumpstate@1.0",
             "android.hardware.health@2.0",
             "android.hardware.light@2.0",
+            "android.hardware.vibrator@1.0",
             "android.hardware.power@1.0",
             "android.hardware.power@1.1",
             "android.hardware.power@1.2",
diff --git a/vibrator/1.0/Android.bp b/vibrator/1.0/Android.bp
new file mode 100644
index 0000000..d6321fb
--- /dev/null
+++ b/vibrator/1.0/Android.bp
@@ -0,0 +1,15 @@
+// This file is autogenerated by hidl-gen -Landroidbp.
+
+hidl_interface {
+    name: "android.hardware.vibrator@1.0",
+    root: "android.hardware",
+    srcs: [
+        "types.hal",
+        "IVibrator.hal",
+    ],
+    interfaces: [
+        "android.hidl.base@1.0",
+    ],
+    gen_java: true,
+    gen_java_constants: true,
+}
diff --git a/vibrator/1.0/IVibrator.hal b/vibrator/1.0/IVibrator.hal
new file mode 100644
index 0000000..757ad0d
--- /dev/null
+++ b/vibrator/1.0/IVibrator.hal
@@ -0,0 +1,72 @@
+/*
+ * Copyright (C) 2016 The Android Open Source Project
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
