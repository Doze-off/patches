diff --git a/libc/Android.bp b/libc/Android.bp
index cfcca5f7e..0da8dabbd 100644
--- a/libc/Android.bp
+++ b/libc/Android.bp
@@ -99,6 +99,9 @@ cc_defaults {
                 malloc_low_memory: {
                     cflags: ["-UUSE_SCUDO"],
                 },
