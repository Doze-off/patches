             },
         },
         lib32: {
@@ -208,6 +211,16 @@ cc_defaults {
                         "libscudo",
                     ],
                 },
+                malloc_use_jemalloc: {
+                    cflags: ["-UUSE_SCUDO"],
+                    whole_static_libs: [
