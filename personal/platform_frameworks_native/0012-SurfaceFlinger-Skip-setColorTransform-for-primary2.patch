From 29cb8087342345ccb0ee0b59bf4793bbe9a09e0d Mon Sep 17 00:00:00 2001
From: Doze-off <viniciussadxxx@gmail.com>
Date: Wed, 24 Jun 2026 19:10:31 +0000
Subject: [PATCH 12/12] SurfaceFlinger: Gate primary display color transform workaround behind PHH property

Some devices, especially certain Unisoc implementations, misbehave when
SurfaceFlinger applies color transforms on the primary display and may end
up with a blank or black screen.

Instead of unconditionally skipping setColorTransform() on the primary
display, gate this workaround behind the
persist.sys.phh.unisoc_color_transform_workaround property.

This keeps the default framework behavior unchanged for all devices and
allows the workaround to be enabled only when needed by the user or a
device-specific configuration.

Change-Id: Ic0d43c21d762750eec718fce9bfaa79e49388495
---
 .../surfaceflinger/DisplayHardware/HWComposer.cpp   | 13 +++++++++----
 1 file changed, 9 insertions(+), 4 deletions(-)

diff --git a/services/surfaceflinger/DisplayHardware/HWComposer.cpp b/services/surfaceflinger/DisplayHardware/HWComposer.cpp
index d7b72b480c..4491194250 100644
--- a/services/surfaceflinger/DisplayHardware/HWComposer.cpp
+++ b/services/surfaceflinger/DisplayHardware/HWComposer.cpp
@@ -41,6 +41,7 @@
 #include "../SurfaceFlingerProperties.h"
 #include "ComposerHal.h"
 #include "HWC2.h"
+#include <android-base/properties.h>
 
 #define LOG_HWC_DISPLAY_ERROR(hwcDisplayId, msg) \
     ALOGE("%s failed for HWC display %" PRIu64 ": %s", __FUNCTION__, hwcDisplayId, msg)
@@ -775,10 +776,14 @@ status_t HWComposer::setActiveModeWithConstraints(
 status_t HWComposer::setColorTransform(HalDisplayId displayId, const mat4& transform) {
     RETURN_IF_INVALID_DISPLAY(displayId, BAD_INDEX);
     
-    if (displayId == getPrimaryDisplayId()) { 
-     LOG_DISPLAY_ERROR(displayId, "SKIP! Not implemented for primary display."); 
-     return NO_ERROR; 
-     } 
+    const bool enabled = android::base::GetBoolProperty(
+            "persist.sys.phh.unisoc_color_transform_workaround", false);
+
+    if (enabled && displayId == getPrimaryDisplayId()) {
+        LOG_DISPLAY_ERROR(displayId,
+                "Skipping setColorTransform on primary display due to user-enabled workaround");
+        return NO_ERROR;
+    }
     
     auto& displayData = mDisplayData[displayId];
     auto error = displayData.hwcDisplay->setColorTransform(transform);
