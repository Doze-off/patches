 services/surfaceflinger/SurfaceFlinger.cpp | 20 +++++++++++++-------
 1 file changed, 13 insertions(+), 7 deletions(-)

diff --git a/services/surfaceflinger/SurfaceFlinger.cpp b/services/surfaceflinger/SurfaceFlinger.cpp
index 97dbf67..49ac00f 100644
--- a/services/surfaceflinger/SurfaceFlinger.cpp
+++ b/services/surfaceflinger/SurfaceFlinger.cpp
@@ -492,11 +492,13 @@ SurfaceFlinger::SurfaceFlinger(Factory& factory) : SurfaceFlinger(factory, SkipI
 
     mDebugFlashDelay = base::GetUintProperty("debug.sf.showupdates"s, 0u);
 
-    property_get("debug.sf.disable_backpressure", value, "0");
-    mPropagateBackpressure = !atoi(value);
-    ALOGI_IF(!mPropagateBackpressure, "Disabling backpressure propagation");
+    // phh: backpressure is disabled by default for GSI compatibility.
+    // the treble app can enable it via enable_sf_hwc_backpressure=true,
+    // or force-disable it via sf_disable_backpressure=true.
+    mPropagateBackpressure = base::GetBoolProperty("persist.sys.phh.enable_sf_hwc_backpressure"s, false)
+            && !base::GetBoolProperty("persist.sys.phh.sf_disable_backpressure"s, false);
 
-    mBackpressureGpuComposition = base::GetBoolProperty("debug.sf.enable_gl_backpressure"s, true);
+    mBackpressureGpuComposition = base::GetBoolProperty("persist.sys.phh.enable_sf_gl_backpressure"s, false);
     ALOGI_IF(mBackpressureGpuComposition, "Enabling backpressure for GPU composition");
 
     property_get("ro.surface_flinger.supports_background_blur", value, "0");
@@ -553,10 +555,14 @@ SurfaceFlinger::SurfaceFlinger(Factory& factory) : SurfaceFlinger(factory, SkipI
 }
 
 LatchUnsignaledConfig SurfaceFlinger::getLatchUnsignaledConfig() {
-    if (base::GetBoolProperty("debug.sf.latch_unsignaled"s, false)) {
+    // phh: force-latch all buffers unsignaled when requested via treble app
+    if (base::GetBoolProperty("persist.sys.phh.sf_latch_unsignaled"s, false)) {
         return LatchUnsignaledConfig::Always;
     }
-    if (base::GetBoolProperty("debug.sf.auto_latch_unsignaled"s, true)) {
+
+    // phh: auto-latch single-layer buffers (default behaviour)
+    if (base::GetBoolProperty("persist.sys.phh.sf_auto_latch_unsignaled"s,
+            base::GetBoolProperty("debug.sf.auto_latch_unsignaled"s, true))) {
         return LatchUnsignaledConfig::AutoSingleLayer;
     }
     return LatchUnsignaledConfig::Disabled;
@@ -2739,7 +2745,7 @@ bool SurfaceFlinger::commit(PhysicalDisplayId pacesetterId,
         }
     }
 
-    if (base::GetBoolProperty("persist.sys.phh.enable_sf_hwc_backpressure"s, true)
+     if (pacesetterFrameTarget.wouldBackpressureHwc()) {
             && pacesetterFrameTarget.isFramePending()) {
         if (mPropagateBackpressure && (mBackpressureGpuComposition || pacesetterFrameTarget.didMissHwcFrame())) {
             if (FlagManager::getInstance().vrr_config()) {
