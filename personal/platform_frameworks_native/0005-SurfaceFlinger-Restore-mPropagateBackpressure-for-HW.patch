From c18585adcf1b0daf9b42a6919e9051285e35dd92 Mon Sep 17 00:00:00 2001
From: doze <doze@doze>
Date: Mon, 23 Mar 2026 00:22:37 +0100
Subject: [PATCH 5/7] SurfaceFlinger-Restore-mPropagateBackpressure-for-HW

---
 opengl/libs/EGL/Loader.cpp                 | 2 --
 services/surfaceflinger/SurfaceFlinger.cpp | 5 ++++-
 services/surfaceflinger/SurfaceFlinger.h   | 4 ++--
 3 files changed, 6 insertions(+), 5 deletions(-)

diff --git a/opengl/libs/EGL/Loader.cpp b/opengl/libs/EGL/Loader.cpp
index ed4529c..ef39add 100644
--- a/opengl/libs/EGL/Loader.cpp
+++ b/opengl/libs/EGL/Loader.cpp
@@ -289,7 +289,6 @@ void* Loader::open(egl_connection_t* cnx) {
     }
 
     // Finally, try to load default driver.
-    bool failToLoadFromDriverSuffixProperty = false;
     if (!hnd) {
         // Start by searching for the library name appended by the system
         // properties of the GLES userspace driver in both locations.
@@ -304,7 +303,6 @@ void* Loader::open(egl_connection_t* cnx) {
             hnd = attempt_to_load_system_driver(cnx, prop.c_str(), true);
             if (!hnd) {
                 ALOGD("Failed to load drivers from property %s with value %s", key, prop.c_str());
-                failToLoadFromDriverSuffixProperty = true;
             }
 
             // Abort regardless of whether subsequent properties are set, the value must be set
diff --git a/services/surfaceflinger/SurfaceFlinger.cpp b/services/surfaceflinger/SurfaceFlinger.cpp
index bea9334..716354e 100644
--- a/services/surfaceflinger/SurfaceFlinger.cpp
+++ b/services/surfaceflinger/SurfaceFlinger.cpp
@@ -539,6 +539,9 @@ SurfaceFlinger::SurfaceFlinger(Factory& factory) : SurfaceFlinger(factory, SkipI
     mBackpressureGpuComposition = base::GetBoolProperty("debug.sf.enable_gl_backpressure"s, true);
     ALOGI_IF(mBackpressureGpuComposition, "Enabling backpressure for GPU composition");
 
+    mPropagateBackpressure = base::GetBoolProperty("persist.sys.phh.enable_sf_hwc_backpressure"s, false);
+    ALOGI_IF(!mPropagateBackpressure, "Disabling backpressure propagation");
+
     property_get("ro.surface_flinger.supports_background_blur", value, "0");
     bool supportsBlurs = atoi(value);
     mSupportsBlur = supportsBlurs;
@@ -2914,7 +2917,7 @@ bool SurfaceFlinger::commit(PhysicalDisplayId pacesetterId,
         }
     }
 
-    if (pacesetterFrameTarget.wouldBackpressureHwc()) {
+    if (pacesetterFrameTarget.isFramePending()) {
         if (mPropagateBackpressure && (mBackpressureGpuComposition || pacesetterFrameTarget.didMissHwcFrame())) {
             mScheduler->getVsyncSchedule()->getTracker().onFrameMissed(
                     pacesetterFrameTarget.expectedPresentTime());
diff --git a/services/surfaceflinger/SurfaceFlinger.h b/services/surfaceflinger/SurfaceFlinger.h
index caec6af..c67a95d 100644
--- a/services/surfaceflinger/SurfaceFlinger.h
+++ b/services/surfaceflinger/SurfaceFlinger.h
@@ -1511,7 +1511,7 @@ private:
     std::atomic_bool mForceFullDamage = false;
 
     bool mLayerCachingEnabled = false;
-    bool mPropagateBackpressure = true;
+    bool mPropagateBackpressure = false;
     bool mBackpressureGpuComposition = false;
 
     LayerTracing mLayerTracing;
@@ -1895,4 +1895,4 @@ private:
     const sp<SurfaceFlinger> mFlinger;
 };
 
-} // namespace android
\ No newline at end of file
+} // namespace android
-- 
2.34.1

