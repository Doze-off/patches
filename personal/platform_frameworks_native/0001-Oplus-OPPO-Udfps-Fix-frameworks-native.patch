 #ifndef TARGET_PROVIDES_UDFPS_LIB
 #include <compositionengine/UdfpsExtension.h>
 
-uint32_t getUdfpsDimZOrder(uint32_t z) {
-    return z;
+uint32_t getUdfpsDimZOrder(uint32_t __unused z) {
