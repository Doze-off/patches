+    if (isAtLeastV && isKernel32Bit() && isX86())
+        ALOGW("[GSI] V+ X86 32-bit kernel - unsupported but continuing");
 
     if (isAtLeastV) {
         bool bad = false;
 
         if (!isLtsKernel()) {
-            ALOGW("Android V+ only supports LTS kernels.");
-            bad = true;
+            ALOGW("[GSI] non-LTS kernel on V+ - unsupported but continuing");
+            // [GSI-PATCH] bad = true removed
         }
 
 
@@ -1652,36 +1577,11 @@ static int doLoad(char** argv, char * const envp[]) {
      * Note, however, that TV and Wear devices will continue to support 32-bit userspace
