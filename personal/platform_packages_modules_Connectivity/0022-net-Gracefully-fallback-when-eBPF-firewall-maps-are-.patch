@@ -914,7 +937,7 @@ public class NetworkStatsService extends INetworkStatsService.Stub {
                 return new BpfMap<>(APP_UID_STATS_MAP_PATH,
                         S32.class, StatsMapValue.class);
             } catch (ErrnoException e) {
