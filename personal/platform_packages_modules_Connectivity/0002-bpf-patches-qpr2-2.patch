From 779a1ab6c466d2ef039d39c8c69dbf9bf81c9eb7 Mon Sep 17 00:00:00 2001
From: dozeoff <dozeoff@dozeoff>
Date: Sat, 14 Feb 2026 18:39:39 +0100
Subject: [PATCH 2/2] bpf patches qpr2-2

---
 bpf/loader/NetBpfLoad.cpp | 11 +++++++----
 1 file changed, 7 insertions(+), 4 deletions(-)

diff --git a/bpf/loader/NetBpfLoad.cpp b/bpf/loader/NetBpfLoad.cpp
index 5ccf3f4..a17a42e 100644
--- a/bpf/loader/NetBpfLoad.cpp
+++ b/bpf/loader/NetBpfLoad.cpp
@@ -1712,7 +1712,7 @@ static int doLoad(char** argv, char * const envp[]) {
             ALOGW("[Arm KernelUpRev] 32-bit userspace unsupported on 6.2+ kernels.");
         } else if (isArm()) {
             ALOGE("[Arm] 64-bit userspace required on 6.2+ kernels (%d).", first_api_level);
-            rfailed = true;
+            failed = true;
         } else { // x86 since RiscV cannot be 32-bit
             ALOGE("[x86] 64-bit userspace required on 6.2+ kernels.");
             failed = true;
@@ -1764,9 +1764,10 @@ static int doLoad(char** argv, char * const envp[]) {
         // but we need 0 (enabled)
         // (this writeFile is known to fail on at least 4.19, but always defaults to 0 on
         // pre-5.13, on 5.13+ it depends on CONFIG_BPF_UNPRIV_DEFAULT_OFF)
-        if (writeProcSysFile("/proc/sys/kernel/unprivileged_bpf_disabled", "0\n")) {
+        if (writeFile("/proc/sys/kernel/unprivileged_bpf_disabled", "0\n")) {
             failed = true;
         }
+    }
 
     if (isAtLeastU) {
         // Note: writing these proc files requires CAP_NET_ADMIN
@@ -1780,17 +1781,19 @@ static int doLoad(char** argv, char * const envp[]) {
         //  kernel does not have CONFIG_BPF_JIT=y)
         // BPF_JIT is required by R VINTF (which means 4.14/4.19/5.4 kernels),
         // but 4.14/4.19 were released with P & Q, and only 5.4 is new in R+.
-        if (writeProcSysFile("/proc/sys/net/core/bpf_jit_enable", "1\n")) {
+        if (writeFile("/proc/sys/net/core/bpf_jit_enable", "1\n")) {
             failed = true;
         }
 
         // Enable JIT kallsyms export for privileged users only
         // (Note: this (open) will fail with ENOENT 'No such file or directory' if
         //  kernel does not have CONFIG_HAVE_EBPF_JIT=y)
-        if (writeProcSysFile("/proc/sys/net/core/bpf_jit_kallsyms", "1\n")) {
+        if (writeFile("/proc/sys/net/core/bpf_jit_kallsyms", "1\n")) {
             failed = true;
         }
 
+    }
+
     // Create all the pin subdirectories
     // (this must be done first to allow create_location and pin_subdir functionality,
     //  which could otherwise fail with ENOENT during object pinning or renaming,
-- 
2.34.1

