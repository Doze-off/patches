+++ b/bpf/netd/BpfHandler.cpp
@@ -55,14 +55,15 @@ constexpr int TOTAL_UID_STATS_ENTRIES_LIMIT = STATS_MAP_SIZE * 0.9;
 static_assert(STATS_MAP_SIZE - TOTAL_UID_STATS_ENTRIES_LIMIT > 100,
               "The limit for stats map is to high, stats data may be lost due to overflow");
 
-static Status attachProgramToCgroup(const char* programPath, const unique_fd& cgroupFd,
+static Status attachProgramToCgroup(const char* programPath,
+                                    const unique_fd& cgroupFd,
                                     bpf_attach_type type) {
-    unique_fd cgroupProg(retrieveProgram(programPath));
-    if (!cgroupProg.ok()) {
-        return statusFromErrno(errno, fmt::format("Failed to get program from {}", programPath));
+    unique_fd prog(retrieveProgram(programPath));
+    if (!prog.ok()) {
+        return statusFromErrno(errno, "retrieveProgram failed");
     }
-    if (bpf::attachProgram(type, cgroupProg, cgroupFd)) {
-        return statusFromErrno(errno, fmt::format("Program {} attach failed", programPath));
+    if (bpf::attachProgram(type, prog, cgroupFd)) {
+        return statusFromErrno(errno, "attachProgram failed");
     }
     return netdutils::status::ok;
 }
@@ -70,136 +71,92 @@ static Status attachProgramToCgroup(const char* programPath, const unique_fd& cg
 static Status checkProgramAccessible(const char* programPath) {
     unique_fd prog(retrieveProgram(programPath));
     if (!prog.ok()) {
-        return statusFromErrno(errno, fmt::format("Failed to get program from {}", programPath));
+        return statusFromErrno(errno, "program not accessible");
     }
     return netdutils::status::ok;
 }
 
+static void tryCheck(const char* name, const char* path) {
+    auto st = checkProgramAccessible(path);
+    if (!st.ok()) {
+        ALOGW("NetBPF: %s not accessible", name);
+    }
+}
+
+static void tryAttach(const char* name,
+                      const char* path,
+                      const unique_fd& fd,
+                      bpf_attach_type type) {
+    auto st = attachProgramToCgroup(path, fd, type);
+    if (!st.ok()) {
+        ALOGW("NetBPF: attach %s failed", name);
+    }
+}
+
