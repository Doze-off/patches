 framework/src/android/net/BpfNetMapsUtils.java               | 5 +++++
 .../com/android/server/connectivity/PermissionMonitor.java   | 4 ++--
 2 files changed, 7 insertions(+), 2 deletions(-)

diff --git a/framework/src/android/net/BpfNetMapsUtils.java b/framework/src/android/net/BpfNetMapsUtils.java
index c0aae8a3a8..80565003d5 100644
--- a/framework/src/android/net/BpfNetMapsUtils.java
+++ b/framework/src/android/net/BpfNetMapsUtils.java
@@ -227,6 +227,11 @@ public class BpfNetMapsUtils {
             }
             return (config.val & match) != 0;
 
+        } catch (Throwable e) {
+            android.util.Log.w("BpfNetMapsUtils",
+                    "Unable to get firewall chain status, defaulting to disabled");
+
+            return false;
         }
     }
 
diff --git a/service/src/com/android/server/connectivity/PermissionMonitor.java b/service/src/com/android/server/connectivity/PermissionMonitor.java
index 0c70bf3452..1e09157480 100755
--- a/service/src/com/android/server/connectivity/PermissionMonitor.java
