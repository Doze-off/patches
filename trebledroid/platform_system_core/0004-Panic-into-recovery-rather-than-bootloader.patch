From b33730fbdf1c03649bd221ac1e94e2156df8f3a0 Mon Sep 17 00:00:00 2001
From: Pierre-Hugues Husson <phh@phh.me>
Date: Mon, 29 Jun 2026 18:04:49 +0000
Subject: [PATCH 4/4] Panic into recovery rather than bootloader

Getting last_kmsg/pstore from bootloader isn't possible for other people
than the OEM, but we have TWRP to access last_kmsg/pstore

---
 init/reboot_utils.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/init/reboot_utils.cpp b/init/reboot_utils.cpp
index 5c402fe..92049ca 100644
--- a/init/reboot_utils.cpp
+++ b/init/reboot_utils.cpp
@@ -38,7 +38,7 @@
 namespace android {
 namespace init {
 
-[[clang::no_destroy]] static std::string init_fatal_reboot_target = "bootloader";
+[[clang::no_destroy]] static std::string init_fatal_reboot_target = "recovery";
 static bool init_fatal_panic = false;
 
 // this needs to read the /proc/* files directly because it is called before
