From a00e8424b385b27634754209407a43e1e8a4fe29 Mon Sep 17 00:00:00 2001
From: Pierre-Hugues Husson <phh@phh.me>
Date: Mon, 29 Jun 2026 06:58:23 +0000
Subject: [PATCH] Let system override ro.apex.updatable

APEX are broken because of a kernel bug in Android 10 devices
So we have system set ro.apex.updatable = false
However, vendor can override system, which prevents us from setting this
to false
So, ignore the override policy for this prop

---
 init/property_service.cpp | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/init/property_service.cpp b/init/property_service.cpp
index 3c7a0f7..6cd6fdc 100644
--- a/init/property_service.cpp
+++ b/init/property_service.cpp
@@ -808,8 +808,14 @@ static void LoadProperties(char* data, const char* filter, const char* filename,
                 } else if (it->second != *expanded_value) {
                     LOG(WARNING) << "Overriding previous property '" << key << "':'" << it->second
                                  << "' with new value '" << *expanded_value << "'";
-                    it->second = std::move(*expanded_value);
-                }
+                    
+                    
+                    if(strcmp("ro.apex.updatable", key) == 0) {
+                        LOG(WARNING) << "... Ignored";
+                    } else {
+                        it->second = std::move(*expanded_value);
+                    }
+		}
             } else {
                 LOG(ERROR) << "Do not have permissions to set '" << key << "' to '"
                            << *expanded_value << "' in property file '" << filename
-- 
