From 416a8da3cc846b1d972ab9d9fb5f2d947b9ff140 Mon Sep 17 00:00:00 2001
From: Pierre-Hugues Husson <phh@phh.me>
Date: Mon, 29 Jun 2026 19:18:05 +0000
Subject: [PATCH 4/4] Disable project_quota on old devices but new enough to
 have encryption (they do keep quota support)

---
 fs_mgr.cpp | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/fs_mgr.cpp b/fs_mgr.cpp
index 7408431..c8f8754 100644
--- a/fs_mgr.cpp
+++ b/fs_mgr.cpp
@@ -450,6 +450,14 @@ static void tune_quota(const std::string& blk_device, const FstabEntry& entry,
         LINFO << "Disabling quotas on legacy devices with encryption disabled";
         want_quota = false;
     }
+    
+    struct utsname uts;
+    unsigned int major, minor;
+
+    if ((uname(&uts) == 0) && (sscanf(uts.release, "%u.%u", &major, &minor) == 2)) {
+        if(major < 4) want_projid = false;
+        if(major == 4 && minor < 9) want_projid = false;
+    }
 
     if (!tune2fs_available()) {
         LERROR << "Unable to " << (want_quota ? "enable" : "disable") << " quotas on " << blk_device
-- 
