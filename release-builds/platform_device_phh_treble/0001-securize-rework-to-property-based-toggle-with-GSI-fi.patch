 phh-on-boot.sh      |  44 ++++++++++++++++
 phh-prop-handler.sh |  11 ++++
 rw-system.sh        | 125 ++++++++++++++++++++++++++++++--------------
 vndk.rc             |   6 +--
 5 files changed, 142 insertions(+), 45 deletions(-)

