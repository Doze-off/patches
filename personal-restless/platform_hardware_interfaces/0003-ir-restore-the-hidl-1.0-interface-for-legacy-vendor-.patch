Subject: [PATCH 3/3] ir: restore the hidl 1.0 interface for legacy vendor hals

---
 ir/1.0/Android.bp      | 18 ++++++++++++++++++
 ir/1.0/IConsumerIr.hal | 40 ++++++++++++++++++++++++++++++++++++++++
 ir/1.0/types.hal       | 24 ++++++++++++++++++++++++
 3 files changed, 82 insertions(+)
 create mode 100644 ir/1.0/Android.bp
 create mode 100644 ir/1.0/IConsumerIr.hal
 create mode 100644 ir/1.0/types.hal

diff --git a/ir/1.0/Android.bp b/ir/1.0/Android.bp
new file mode 100644
index 0000000..4054144
--- /dev/null
+++ b/ir/1.0/Android.bp
@@ -0,0 +1,18 @@
+// This file is autogenerated by hidl-gen -Landroidbp.
+
+package {
+    default_applicable_licenses: ["hardware_interfaces_license"],
+}
+
+hidl_interface {
+    name: "android.hardware.ir@1.0",
+    root: "android.hardware",
+    srcs: [
+        "types.hal",
+        "IConsumerIr.hal",
+    ],
+    interfaces: [
+        "android.hidl.base@1.0",
+    ],
+    gen_java: true,
+}
diff --git a/ir/1.0/IConsumerIr.hal b/ir/1.0/IConsumerIr.hal
new file mode 100644
index 0000000..0881dfb
--- /dev/null
+++ b/ir/1.0/IConsumerIr.hal
@@ -0,0 +1,40 @@
