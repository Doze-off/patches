+status_t Camera3Device::RequestThread::setSamsungVideoFps(bool enabled, bool restart,
+        int32_t fps, int32_t maxFps) {
+    ATRACE_CALL();
+    Mutex::Autolock l(mTriggerMutex);
+    mSamsungVideoFpsEnabled = enabled;
+    mSamsungVideoFps = fps;
+    mSamsungMaxFps = maxFps;
+    mSamsungFpsRestart = restart;
+    return OK;
+}
+
+bool Camera3Device::RequestThread::overrideSamsungVideoFps(const sp<CaptureRequest> &request) {
+    Mutex::Autolock l(mTriggerMutex);
+    if (!mSamsungVideoFpsEnabled) return false;
+
+    auto& settings = *request->mSettingsList.begin();
+    int32_t range[2] = {settings.mOriginalAeTargetFpsRange[0],
+            settings.mOriginalAeTargetFpsRange[1]};
+    if (mSamsungVideoFps != 0) {
+        range[0] = mSamsungVideoFps;
+        range[1] = mSamsungVideoFps;
+    }
+    if (range[1] == 0) return false;
+
+    // The HAL enters its 60fps sensor mode only on a rise past 30fps and drops it on reconfigure
+    int32_t maxFps = mSamsungMaxFps;
+    if (mSamsungFpsRestart && mSamsungLastFps > kSamsungDefaultMaxFps) {
+        maxFps = kSamsungDefaultMaxFps;
+    }
+    mSamsungFpsRestart = false;
+    if (maxFps != 0 && range[1] > maxFps) {
+        range[0] = std::min(range[0], maxFps);
+        range[1] = maxFps;
+    }
+    mSamsungLastFps = range[1];
+
+    auto entry = settings.metadata.find(ANDROID_CONTROL_AE_TARGET_FPS_RANGE);
+    if (entry.count == 2 && entry.data.i32[0] == range[0] && entry.data.i32[1] == range[1]) {
+        return false;
+    }
+    settings.metadata.update(ANDROID_CONTROL_AE_TARGET_FPS_RANGE, range, 2);
+    return true;
+}
