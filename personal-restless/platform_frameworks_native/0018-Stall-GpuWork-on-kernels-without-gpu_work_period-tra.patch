From b879e0e7cfe570030740a10c211cb3f476321f8a Mon Sep 17 00:00:00 2001
From: "Christopher A. Williamson" <contact@chrisaw.io>
Date: Mon, 9 Nov 2026 01:26:35 +0000
Subject: [PATCH 18/18] Stall GpuWork on kernels without gpu_work_period
 tracepoint

---
 services/gpuservice/gpuwork/GpuWork.cpp    |  9 +++++++++
 services/surfaceflinger/SurfaceFlinger.cpp | 18 +++++++++++++-----
 2 files changed, 22 insertions(+), 5 deletions(-)

diff --git a/services/gpuservice/gpuwork/GpuWork.cpp b/services/gpuservice/gpuwork/GpuWork.cpp
index 08cf43c..b34ddff 100644
--- a/services/gpuservice/gpuwork/GpuWork.cpp
+++ b/services/gpuservice/gpuwork/GpuWork.cpp
@@ -26,6 +26,7 @@
 #include <bpf/WaitForProgsLoaded.h>
 #include <libbpf.h>
 #include <log/log.h>
+#include <sys/stat.h>
 #include <random>
 #include <stats_event.h>
 #include <statslog_gpustats.h>
@@ -144,6 +145,14 @@ void GpuWork::initialize() {
     // Workaround b/347947040 by allowing time for statsd / bpf setup.
     std::this_thread::sleep_for(std::chrono::seconds(30));
 
+    // If the gpu_work_period tracepoint does not exist (e.g. older/GSI kernels),
+    // stall this thread forever to prevent gpuservice from crash-looping.
+    struct stat sb;
+    if (stat("/sys/kernel/tracing/events/power/gpu_work_period", &sb) != 0) {
+        ALOGI("gpu_work_period tracepoint not found, stalling");
+        while (true) sleep(1);
+    }
+
     // Make sure BPF programs are loaded.
     bpf::waitForProgsLoaded();
 
diff --git a/services/surfaceflinger/SurfaceFlinger.cpp b/services/surfaceflinger/SurfaceFlinger.cpp
index 866e863..a024774 100644
--- a/services/surfaceflinger/SurfaceFlinger.cpp
+++ b/services/surfaceflinger/SurfaceFlinger.cpp
@@ -555,7 +555,11 @@ SurfaceFlinger::SurfaceFlinger(Factory& factory) : SurfaceFlinger(factory, SkipI
     mBackpressureGpuComposition = base::GetBoolProperty("debug.sf.enable_gl_backpressure"s, true);
     ALOGI_IF(mBackpressureGpuComposition, "Enabling backpressure for GPU composition");
 
-    mPropagateBackpressure = base::GetBoolProperty("persist.sys.phh.enable_sf_hwc_backpressure"s, false);
+    // phh: backpressure is disabled by default for GSI compatibility.
+    // the treble app can enable it via enable_sf_hwc_backpressure=true,
+    // or force-disable it via sf_disable_backpressure=true.
+    mPropagateBackpressure = base::GetBoolProperty("persist.sys.phh.enable_sf_hwc_backpressure"s, false)
+            && !base::GetBoolProperty("persist.sys.phh.sf_disable_backpressure"s, false);
     ALOGI_IF(!mPropagateBackpressure, "Disabling backpressure propagation");
 
     property_get("ro.surface_flinger.supports_background_blur", value, "0");
@@ -613,13 +617,17 @@ SurfaceFlinger::SurfaceFlinger(Factory& factory) : SurfaceFlinger(factory, SkipI
 }
 
 LatchUnsignaledConfig SurfaceFlinger::getLatchUnsignaledConfig() {
-    if (base::GetBoolProperty("debug.sf.latch_unsignaled"s, false)) {
+    // phh: force-latch all buffers unsignaled when requested via treble app
+    if (base::GetBoolProperty("persist.sys.phh.sf_latch_unsignaled"s, false)) {
         return LatchUnsignaledConfig::Always;
     }
-    if (base::GetBoolProperty("debug.sf.auto_latch_unsignaled"s, true)) {
-        return LatchUnsignaledConfig::AutoSingleLayer;
+
+    // phh: auto-latch single-layer buffers (default behaviour)
+    if (base::GetBoolProperty("persist.sys.phh.sf_auto_latch_unsignaled"s,
+            base::GetBoolProperty("debug.sf.auto_latch_unsignaled"s, true))) {
     }
-    return LatchUnsignaledConfig::Disabled;
+    return LatchUnsignaledConfig::AutoSingleLayer;
+
 }
 
 SurfaceFlinger::~SurfaceFlinger() = default;
